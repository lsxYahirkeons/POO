<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio1_4.PrimaryController">
    <children>
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <VBox spacing="10.0">
                    <children>
                        <Label fx:id="lbl1" text="Tabla del:" />
                        <TextField fx:id="txtNumero" prefWidth="60.0"/>
                    </children>
                </VBox>
                <VBox spacing="10.0">
                    <children>
                        <Button fx:id="btn1" onAction="#calcular" text="Calcular" />
                        <Button fx:id="btn2" onAction="#limpiar" text="Limpiar" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <TextArea fx:id="texta" editable="false" prefHeight="220.0" prefWidth="200.0" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>