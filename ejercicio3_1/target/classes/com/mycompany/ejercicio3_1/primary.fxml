<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio3_1.PrimaryController">
    <children>
        <Label fx:id="lbl1" text="Contar número de clics" />
        <TextField fx:id="txtContador" alignment="CENTER" editable="false" prefWidth="250.0" text="0" />
        <Button fx:id="btnContar" onAction="#contar" text="¡Contar!" />
        <VBox prefHeight="10.0" />
        <Label fx:id="lbl2" text="Esperar 10 segundos" />
        <ProgressBar fx:id="prgTiempo" prefWidth="300.0" progress="0.0" />
        <Button fx:id="btnEsperar" onAction="#esperar" text="¡Esperar!" />
    </children>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>